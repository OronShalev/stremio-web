# Copy to .env and adjust. Used by docker-compose.yml.

# Folder on your computer where downloads are stored (shared by qBittorrent and the downloads service).
# Windows (Docker Desktop): use forward slashes.
DOWNLOADS_HOST_DIR=C:/Users/orons/AppData/Stremio/downloads

# Time zone for qBittorrent logs
TZ=Asia/Jerusalem

# User / group the qBittorrent container writes files as (only matters on Linux hosts)
PUID=1000
PGID=1000
